---
import { BrainCircuit } from "lucide-react";
import ThemeToggle from "./ThemeToggle";

const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-border bg-card px-5 py-3 text-base text-foreground"
>
  <a href="/dashboard" class="flex items-center gap-2 font-semibold text-foreground hover:opacity-80">
    <BrainCircuit className="size-6" />
    10xCards
  </a>

  {
    user ? (
      <div class="flex items-center gap-3">
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="font-medium text-foreground/60 transition-colors hover:text-foreground">
            Wyloguj
          </button>
        </form>
        <ThemeToggle client:load />
      </div>
    ) : (
      <div class="flex items-center gap-3">
        <a href="/auth/signin" class="font-medium text-foreground/80 transition-colors hover:text-foreground">
          Zaloguj się
        </a>
        <a href="/auth/signup" class="font-medium text-foreground/80 transition-colors hover:text-foreground">
          Zarejestruj się
        </a>
        <ThemeToggle client:load />
      </div>
    )
  }
</div>
