---
import { BrainCircuit } from "lucide-react";
import ThemeToggle from "./ThemeToggle";

const { user } = Astro.locals;
---

<div
  class="border-border bg-card text-foreground mb-4 flex items-center justify-between rounded-xl border px-5 py-3 text-base"
>
  <a href="/dashboard" class="text-foreground flex items-center gap-2 font-semibold hover:opacity-80">
    <BrainCircuit className="size-6" />
    10xCards
  </a>

  {
    user ? (
      <div class="flex items-center gap-3">
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-foreground/60 hover:text-foreground font-medium transition-colors">
            Wyloguj
          </button>
        </form>
        <ThemeToggle client:load />
      </div>
    ) : (
      <div class="flex items-center gap-3">
        <a href="/auth/signin" class="text-foreground/80 hover:text-foreground font-medium transition-colors">
          Zaloguj się
        </a>
        <a href="/auth/signup" class="text-foreground/80 hover:text-foreground font-medium transition-colors">
          Zarejestruj się
        </a>
        <ThemeToggle client:load />
      </div>
    )
  }
</div>
