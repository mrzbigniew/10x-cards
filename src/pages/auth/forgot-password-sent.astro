---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Check your email">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="border-border bg-card text-foreground w-full max-w-sm rounded-2xl border p-8 text-center backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-500 to-purple-500 bg-clip-text text-2xl font-bold text-transparent">
        Sprawdź skrzynkę
      </h1>
      <p class="text-foreground/80 mb-4">
        Jeśli konto istnieje dla tego adresu, wysłaliśmy link do resetowania hasła. Kliknij go w ciągu 24 godzin.
      </p>
      <p class="text-muted-foreground mb-6 text-sm">Nie widzisz? Sprawdź folder spam lub niechciane.</p>
      {
        import.meta.env.DEV && (
          <p class="mb-6 text-sm text-blue-100/60">
            Dev mode:{" "}
            <a
              href="http://localhost:54324"
              class="text-purple-300 hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open Inbucket
            </a>{" "}
            to view the email.
          </p>
        )
      }
      <a href="/auth/signin" class="text-sm text-purple-600 hover:underline dark:text-purple-400">Wróć do logowania</a>
    </div>
  </div>
</Layout>
