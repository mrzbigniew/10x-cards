---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Check your email">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Check your email
      </h1>
      <p class="mb-4 text-blue-100/80">
        If an account exists for that address, we've sent a password reset link. Click it within 24 hours.
      </p>
      <p class="mb-6 text-sm text-blue-100/60">Don't see it? Check your spam or junk folder.</p>
      {
        import.meta.env.DEV && (
          <p class="mb-6 text-sm text-blue-100/60">
            Dev mode:{" "}
            <a
              href="http://localhost:54324"
              class="text-purple-300 hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open Inbucket
            </a>{" "}
            to view the email.
          </p>
        )
      }
      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline">Back to sign in</a>
    </div>
  </div>
</Layout>
