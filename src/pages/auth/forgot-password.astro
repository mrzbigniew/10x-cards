---
import Layout from "@/layouts/Layout.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Forgot password">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-foreground w-full max-w-sm rounded-2xl border p-8 backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-500 to-purple-500 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Zapomniałem hasła
      </h1>
      <p class="text-muted-foreground mb-6 text-center text-sm">
        Podaj swój adres e-mail, a wyślemy Ci link do resetowania hasła.
      </p>
      <ForgotPasswordForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        <a href="/auth/signin" class="text-purple-600 hover:underline dark:text-purple-400">Wróć do logowania</a>
      </p>
    </div>
  </div>
</Layout>
