---
import Layout from "@/layouts/Layout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { createClient } from "@/lib/supabase";

const code = Astro.url.searchParams.get("code");
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (supabase) {
  if (code) {
    const { error: exchangeError } = await supabase.auth.exchangeCodeForSession(code);
    if (exchangeError) {
      return Astro.redirect("/auth/forgot-password?error=Link+expired+or+already+used");
    }
  } else {
    const {
      data: { user },
    } = await supabase.auth.getUser();
    if (!user) {
      return Astro.redirect("/auth/forgot-password?error=Link+expired+or+already+used");
    }
  }
} else {
  return Astro.redirect("/auth/forgot-password?error=Link+expired+or+already+used");
}
---

<Layout title="Set new password">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Set new password
      </h1>
      <ResetPasswordForm serverError={error} client:load />
    </div>
  </div>
</Layout>
