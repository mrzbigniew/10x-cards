---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { ReviewPageMount } from "@/components/review/ReviewPageMount";

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}
---

<Layout title="Review">
  <div class="bg-cosmic flex min-h-screen flex-col p-4">
    <Topbar />
    <div class="flex flex-1 flex-col items-center justify-start pt-8">
      <ReviewPageMount deckId={id} client:only="react" />
    </div>
  </div>
</Layout>
