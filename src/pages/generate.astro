---
import Layout from "@/layouts/Layout.astro";
import { GenerationFlow } from "@/components/generation/GenerationFlow";
import Topbar from "@/components/Topbar.astro";
---

<Layout title="Generate Flashcards">
  <div class="bg-cosmic flex min-h-screen flex-col p-4">
    <Topbar />
  <div class="flex flex-1 items-center justify-center">
    <div class="rounded-2xl border border-border bg-card p-8 text-center text-foreground backdrop-blur-xl">
      <div class="mx-auto max-w-3xl py-8">
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-foreground">Generowanie fiszek</h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Wklej notatki lub tekst z podręcznika — AI zaproponuje fiszki do weryfikacji.
          </p>
        </div>
        <GenerationFlow client:load />
      </div>
    </div>
  </div>
  </div>
</Layout>
