---
import Layout from "@/layouts/Layout.astro";
import { GenerationFlow } from "@/components/generation/GenerationFlow";
---

<Layout title="Generate Flashcards">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <div class="mx-auto max-w-3xl py-8">
        <div class="mb-8">
          <h1 class="text-2xl font-bold text-white">Generowanie fiszek</h1>
          <p class="mt-1 text-sm text-white/50">
            Wklej notatki lub tekst z podręcznika — AI zaproponuje fiszki do weryfikacji.
          </p>
        </div>
        <GenerationFlow client:load />
      </div>
    </div>
  </div>
</Layout>
