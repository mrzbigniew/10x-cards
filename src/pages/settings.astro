---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { DeleteAccountSection } from "@/components/settings/DeleteAccountSection";
---

<Layout title="Ustawienia">
  <div class="bg-cosmic flex min-h-screen flex-col p-4">
    <Topbar />
    <div class="flex flex-1 flex-col items-center justify-start pt-8">
      <div class="w-full max-w-2xl space-y-6">
        <h1 class="text-foreground text-2xl font-bold">Ustawienia</h1>

        <div class="border-border bg-card rounded-2xl border p-6 backdrop-blur-xl">
          <h2 class="text-foreground mb-4 text-lg font-semibold">Konto</h2>
          <div class="space-y-2">
            <p class="text-muted-foreground text-sm">Adres e-mail</p>
            <p class="text-foreground font-medium">{Astro.locals.user?.email}</p>
          </div>
        </div>

        <div class="border-border bg-card rounded-2xl border p-6 backdrop-blur-xl">
          <h2 class="text-foreground mb-4 text-lg font-semibold">Hasło</h2>
          <div class="flex items-center gap-3">
            <button
              disabled
              class="border-border bg-card text-foreground/40 cursor-not-allowed rounded-lg border px-4 py-2 text-sm font-medium"
            >
              Zmień hasło
            </button>
            <span class="text-muted-foreground text-sm">Wkrótce</span>
          </div>
        </div>

        <div class="border-destructive/30 bg-card rounded-2xl border p-6 backdrop-blur-xl">
          <h2 class="text-destructive mb-2 text-lg font-semibold">Usuń konto</h2>
          <p class="text-muted-foreground mb-4 text-sm">
            Ta operacja jest nieodwracalna. Wszystkie Twoje dane (zestawy, fiszki, historia powtórek) zostaną trwale
            usunięte.
          </p>
          <DeleteAccountSection client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
