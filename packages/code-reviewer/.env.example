# Local development: the package reads OPENROUTER_API_KEY directly.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# CI only: the GitHub Actions secret is named LLM_PROVIDER_API_KEY; the
# reviewer composite action maps it to OPENROUTER_API_KEY at runtime.
# LLM_PROVIDER_API_KEY=your-openrouter-api-key-here
